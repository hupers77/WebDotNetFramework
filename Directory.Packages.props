<Project>
  <!--
    중앙 패키지 버전 관리. 여기에 없는 패키지는 프로젝트에서 참조할 수 없다.
    새 패키지는 설계서 2장 허용 목록과 eng/allowed-packages.txt에 먼저 추가한다(아키텍트 승인).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- 전이 의존성도 아래 버전으로 고정해 취약 버전이 끌려오지 않게 한다 -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- 런타임 (Microsoft, MIT) -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageVersion Include="System.DirectoryServices.Protocols" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- 런타임 (OSS, MIT). QRCoder는 1.7부터 net6+에 System.Drawing.Common이 따라오므로 의존성 없는 1.6에 둔다 -->
    <PackageVersion Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 보안 패치 고정: 전이 의존성의 취약 버전 대체 (NU1902/NU1903) -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- 테스트 전용 (배포물에 포함되지 않음) -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- DB 프로젝트 빌드 전용: master DB 참조(시스템 카탈로그 뷰). 배포물에 포함되지 않음 -->
    <PackageVersion Include="Microsoft.SqlServer.Dacpacs.Master" Version="160.2.2" />
  </ItemGroup>
</Project>
