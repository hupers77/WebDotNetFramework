<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- 웹 호스트: Program.cs, 레이아웃, 로그인, 외부 API(/api/v1) -->
  <PropertyGroup>
    <UserSecretsId>portal-web-local</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Portal.Core\Portal.Core.csproj" />
    <ProjectReference Include="..\Portal.Data\Portal.Data.csproj" />
    <ProjectReference Include="..\Portal.Security\Portal.Security.csproj" />
    <ProjectReference Include="..\Portal.Framework.Web\Portal.Framework.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" />
  </ItemGroup>
  <!-- 디자인 프로필(Profiles/<이름>/): 실행 폴더로 복사하고, appsettings Portal:Ui:Profile로 하나를 고른다 -->
  <ItemGroup>
    <Content Remove="Profiles\**" />
    <None Remove="Profiles\**" />
    <Content Include="Profiles\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Portal.UnitTests" />
    <InternalsVisibleTo Include="Portal.IntegrationTests" />
  </ItemGroup>
</Project>
