@inject Portal.Infrastructure.Localization.LangResources Lang
<!DOCTYPE html>
<html lang="@CurrentUser.LangCd">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="fw-i18n" content="@Url.Content($"~/i18n/{CurrentUser.LangCd}.json?v={Lang.Version}")" />
    <title>@ViewData["Title"] - @L["SITE.NAME"]</title>
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/theme.css" />
    <script type="module" src="~/js/fw.js" asp-append-version="true"></script>
</head>
<body class="auth">
    <div class="auth-wrap">
        <aside class="auth-brand">
            <span class="brand-mark" aria-hidden="true">@(L["SITE.NAME"].Length > 0 ? L["SITE.NAME"][..1] : "P")</span>
            <p class="auth-brand-name">@L["SITE.NAME"]</p>
            <p class="auth-brand-tag">@L["LOGIN.TAGLINE"]</p>
        </aside>
        <main class="auth-box">
            @RenderBody()
        </main>
    </div>
</body>
</html>
