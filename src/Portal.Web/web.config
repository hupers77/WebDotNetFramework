<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 설정 (설계서 9장 '정보 노출', 개발 표준 가이드 첨부 절). dotnet publish가 aspNetCore 요소의 processPath·arguments를 채워 넣는다.
  - Server / X-Powered-By 헤더를 지우고, 디렉터리 목록을 끄고, TRACE·TRACK 등 쓰지 않는 메서드와 숨김 경로를 막는다.
  - 요청 본문 한도(maxAllowedContentLength)는 첨부 한도 FILE.MAX_SIZE_MB보다 조금 크게 둔다(기본 30MB). FILE.MAX_SIZE_MB를 올리면 함께 올린다.
  - 보안 응답 헤더(CSP·HSTS 등)는 애플리케이션(SecurityHeadersMiddleware)이 붙이므로 여기서 다시 넣지 않는다.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Portal.Web.dll" stdoutLogEnabled="false" hostingModel="inprocess" />
      <directoryBrowse enabled="false" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <security>
        <requestFiltering removeServerHeader="true" allowDoubleEscaping="false">
          <requestLimits maxAllowedContentLength="31457280" maxUrl="4096" maxQueryString="2048" />
          <verbs allowUnlisted="true">
            <add verb="TRACE" allowed="false" />
            <add verb="TRACK" allowed="false" />
            <add verb="PROPFIND" allowed="false" />
            <add verb="PROPPATCH" allowed="false" />
            <add verb="MKCOL" allowed="false" />
            <add verb="COPY" allowed="false" />
            <add verb="MOVE" allowed="false" />
            <add verb="LOCK" allowed="false" />
            <add verb="UNLOCK" allowed="false" />
          </verbs>
          <hiddenSegments>
            <add segment="App_Data" />
            <add segment="keys" />
            <add segment="logs" />
          </hiddenSegments>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
