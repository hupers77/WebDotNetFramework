@model CompanyIndexModel
@{
    var title = Menus.ProgramTitle(CompanyController.ProgramId, CurrentUser.LangCd);
    ViewData["Title"] = title;
}
@section Scripts {
    <script type="module" src="~/js/sys/company.js" asp-append-version="true"></script>
}
<h1>@title</h1>
<div id="company-screen" class="md-layout"
     data-url-list="@Url.Action("List")"
     data-url-create="@Url.Action("Create")"
     data-url-save="@Url.Action("Save")"
     data-url-delete="@Url.Action("Delete")"
     data-my-company="@CurrentUser.CompanyCd"
     data-partner-nm="@Model.Types.FirstOrDefault(t => t.Code == CompanyTypes.Partner).Name">
    <section class="md-master" aria-labelledby="company-list-heading">
        <h2 id="company-list-heading">@L["LBL.COMPANY_LIST"]</h2>
        <form id="company-search" class="search-bar" role="search">
            <label for="company-type-filter">@L["LBL.COMPANY_TYPE"]</label>
            <select id="company-type-filter">
                <option value="">@L["LBL.ALL"]</option>
                @foreach (var (code, name) in Model.Types)
                {
                    <option value="@code">@name</option>
                }
            </select>
            <label for="company-use-filter">@L["LBL.USE_YN"]</label>
            <select id="company-use-filter">
                <option value="">@L["LBL.ALL"]</option>
                <option value="Y" selected>@L["LBL.IN_USE"]</option>
                <option value="N">@L["LBL.NOT_IN_USE"]</option>
            </select>
            <label for="company-keyword">@L["LBL.KEYWORD"]</label>
            <input id="company-keyword" type="search" maxlength="100" autocomplete="off" />
            <button type="submit">@L["BTN.SEARCH"]</button>
        </form>
        <div class="toolbar">
            <p id="company-total" class="hint toolbar-spacer" aria-live="polite"></p>
            <fw-button func="CREATE" text-key="BTN.NEW" id="company-new" />
        </div>
        <ul id="company-list" class="pick-list" role="listbox" aria-labelledby="company-list-heading"></ul>
        <div id="company-pager" class="pager" hidden>
            <button type="button" id="company-prev">@L["BTN.PREV"]</button>
            <span id="company-page" aria-live="polite"></span>
            <button type="button" id="company-next">@L["BTN.NEXT"]</button>
        </div>
    </section>
    <section class="md-detail" aria-labelledby="company-heading">
        <h2 id="company-heading">@L["LBL.COMPANY_DETAIL"]</h2>
        <p id="company-hint" class="hint">@L["SYS.COMPANY.SELECT"]</p>
        <div id="company-detail" hidden>
            <dl class="detail-list">
                <dt>@L["LBL.COMPANY_TYPE"]</dt><dd data-field="type"></dd>
                <dt>@L["LBL.USER_CNT"]</dt><dd data-field="userCnt"></dd>
                <dt>@L["LBL.UPD_DT"]</dt><dd data-field="upd"></dd>
            </dl>
            <p id="company-hq-hint" class="hint" hidden>@L["SYS.COMPANY.HQ_HINT"]</p>
            <form id="company-form" class="form" novalidate>
                <label for="company-cd">@L["LBL.COMPANY_CD"]</label>
                <input id="company-cd" maxlength="10" readonly aria-describedby="company-cd-hint" placeholder="@L["SYS.COMPANY.CD_AUTO"]" />
                <p id="company-cd-hint" class="hint">@L["SYS.COMPANY.CD_HINT"]</p>
                <label for="company-nm">@L["LBL.COMPANY_NM"]</label>
                <input id="company-nm" maxlength="100" autocomplete="off" required />
                <label for="company-biz">@L["LBL.BIZ_REG_NO"]</label>
                <input id="company-biz" maxlength="20" inputmode="numeric" autocomplete="off" />
                <label for="company-end">@L["LBL.CONTRACT_END_DT"]</label>
                <input id="company-end" type="date" aria-describedby="company-end-hint" />
                <p id="company-end-hint" class="hint">@L["SYS.COMPANY.CONTRACT_HINT"]</p>
                <label for="company-ip">@L["LBL.ALLOW_IP"]</label>
                <textarea id="company-ip" rows="3" maxlength="1000" spellcheck="false" aria-describedby="company-ip-hint company-ip-self"></textarea>
                <p id="company-ip-hint" class="hint">@L["SYS.COMPANY.IP_HINT"]</p>
                <p id="company-ip-self" class="hint" hidden>@L["SYS.COMPANY.IP_SELF_HINT", CurrentUser.ClientIp ?? "-"]</p>
                <label for="company-sort">@L["LBL.SORT_NO"]</label>
                <input id="company-sort" type="number" min="0" max="99999" step="1" />
                <label><input id="company-use" type="checkbox" /> @L["LBL.USE_YN"]</label>
            </form>
            <div class="toolbar">
                <fw-button func="DELETE" text-key="BTN.DELETE" id="company-delete" />
                <fw-button func="CREATE" text-key="BTN.SAVE" id="company-create" class="primary" />
                <fw-button func="UPDATE" text-key="BTN.SAVE" id="company-save" class="primary" />
            </div>
        </div>
    </section>
</div>
